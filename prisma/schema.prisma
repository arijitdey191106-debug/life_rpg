// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RPG Stats
  level     Int @default(1)
  xp        Int @default(0)
  gold      Int @default(0)
  goldSpent Int @default(0)

  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  lastActive    DateTime?

  // Attributes
  intellect  Int @default(0)
  strength   Int @default(0)
  discipline Int @default(0)
  creativity Int @default(0)
  focus      Int @default(0)

  // Audio/Profile Settings
  masterVolume  Int     @default(100)
  uiVolume      Int     @default(100)
  ambientVolume Int     @default(100)
  rewardVolume  Int     @default(100)
  isMuted       Boolean @default(false)
  reducedMotion Boolean @default(false)

  // Relations
  quests             Quest[]
  inventory          UserItem[]
  achievements       UserAchievement[]
  focusSessions      FocusSession[]
  meditationSessions MeditationSession[]
  userChallenges     UserChallenge[]
  avatars            UserAvatar[]
  skills             UserSkill[]
  
  // Social & Location
  friendships      Friendship[]    @relation("UserFriendships")
  friendOf         Friendship[]    @relation("UserFriendOf")
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  locationOptIn    Boolean         @default(false)
  approxLat        Float?
  approxLng        Float?
  locationUpdatedAt DateTime?

  // Duels & Transactions
  duelsChallenged  Duel[]              @relation("DuelChallenger")
  duelsDefended    Duel[]              @relation("DuelDefender")
  duelsWon         Duel[]              @relation("DuelWinner")
  rewardTransactions RewardTransaction[]
}

model Quest {
  id                String    @id @default(cuid())
  userId            String
  title             String
  description       String?
  category          String // INTELLECT, STRENGTH, DISCIPLINE, CREATIVITY, FOCUS
  difficulty        String // EASY, MEDIUM, HARD, EPIC
  duration          Int? // estimated minutes
  xpReward          Int
  goldReward        Int
  status            String    @default("PENDING") // PENDING, COMPLETED
  type              String    @default("PERSONAL") // PERSONAL, SYSTEM
  dueDate           DateTime?
  isRecurring       Boolean   @default(false)
  recurringInterval String? // DAILY, WEEKLY, MONTHLY
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id          String @id @default(cuid())
  name        String
  description String
  type        String // FRAME, BADGE, THEME, BACKGROUND, EFFECT
  rarity      String // COMMON, RARE, EPIC, LEGENDARY
  cost        Int
  icon        String @default("🔮")

  users UserItem[]
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String @default("🏆")
  rarity      String @default("COMMON")
  xpReward    Int    @default(0)
  goldReward  Int    @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model FocusSession {
  id                  String   @id @default(cuid())
  userId              String
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  plannedDuration     Int      // minutes
  validActiveDuration Int      @default(0) // seconds
  interruptionCount   Int      @default(0)
  status              String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABORTED
  rewardGranted       Boolean  @default(false)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeditationSession {
  id            String   @id @default(cuid())
  userId        String
  mode          String   // BREATHING, MINDFULNESS, DEEP_CALM, SLEEP
  duration      Int      // minutes
  startedAt     DateTime @default(now())
  completed     Boolean  @default(false)
  rewardGranted Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemChallenge {
  id            String @id @default(cuid())
  key           String @unique
  name          String
  description   String
  category      String // INTELLECT, STRENGTH, DISCIPLINE, CREATIVITY, FOCUS, ALL
  difficulty    String
  unlockLevel   Int    @default(1)
  xpReward      Int
  goldReward    Int
  icon          String @default("⚔️")
  type          String @default("MILESTONE") // DAILY, WEEKLY, MILESTONE

  userChallenges UserChallenge[]
}

model UserChallenge {
  id            String   @id @default(cuid())
  userId        String
  challengeId   String
  status        String   @default("AVAILABLE") // AVAILABLE, COMPLETED
  progress      Int      @default(0)
  completedAt   DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge SystemChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Avatar {
  id          String @id @default(cuid())
  name        String
  rarity      String @default("COMMON")
  imageUrl    String
  unlockLevel Int    @default(1)

  userAvatars UserAvatar[]
}

model UserAvatar {
  id        String  @id @default(cuid())
  userId    String
  avatarId  String?
  imageUrl  String? // For user uploaded custom avatars
  equipped  Boolean @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar Avatar? @relation(fields: [avatarId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt  DateTime @default(now())

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model SkillNode {
  id                String @id @default(cuid())
  attribute         String // INTELLECT, etc
  name              String
  description       String
  requiredAttrLevel Int    @default(1)

  userSkills UserSkill[]
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillNodeId String
  unlockedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillNode SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, skillNodeId])
}

model RewardTransaction {
  id          String   @id @default(cuid())
  userId      String
  sourceId    String   // The Quest, Challenge, or Duel ID
  sourceType  String   // QUEST, SYSTEM_CHALLENGE, DUEL
  xpGranted   Int      @default(0)
  goldGranted Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, sourceType])
}

model Duel {
  id             String   @id @default(cuid())
  challengerId   String
  defenderId     String
  objectiveType  String   // FOCUS, MEDITATION, STRENGTH, INTELLECT
  wager          Int      @default(0)
  status         String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED
  winnerId       String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  challenger User  @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  defender   User  @relation("DuelDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  winner     User? @relation("DuelWinner", fields: [winnerId], references: [id])
}

model WorldLocation {
  id               String @id @default(cuid())
  name             String
  description      String
  unlockLevel      Int    @default(1)
  relatedAttribute String? // INTELLECT, STRENGTH, etc.
  visualType       String // CITY, GYM, ACADEMY, ARENA, FOREST, TEMPLE
}
